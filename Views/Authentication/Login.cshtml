@model CWLoginCredentials

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ComputerWala - Account Access</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            brand: {
                                bg: '#FCFAF4',         // Warm off-white background from image
                                card: '#FFFFFF',       // Clean white container
                                text: '#222222',       // Dark primary text
                                subtext: '#666666',    // Muted text
                                gold: '#C89B4C',       // Primary golden-brown accent
                                goldHover: '#B5883B',  // Darker gold for buttons hover
                                goldLight: '#F7EEDD',  // Light gold tint for active states/badges
                                goldBorder: '#E5D6B8'  // Subtle warm borders
                            }
                        },
                        fontFamily: {
                            script: ['Great Vibes', 'cursive'],
                            sans: ['Outfit', 'sans-serif']
                        }
                    }
                }
            }
    </script>
    <style>
            body {
                background-color: #FCFAF4;
                font-family: 'Outfit', sans-serif;
                color: #222222;
            }

            .brand-script {
                font-family: 'Great Vibes', cursive;
            }

            .tab-active {
                color: #C89B4C;
                border-bottom: 2px solid #C89B4C;
            }

            .input-focus:focus-within {
                border-color: #C89B4C;
                box-shadow: 0 0 0 3px rgba(200, 155, 76, 0.15);
            }
            /* Custom scrollbar for subtle aesthetics */
            ::-webkit-scrollbar {
                width: 6px;
            }

            ::-webkit-scrollbar-track {
                background: #FCFAF4;
            }

            ::-webkit-scrollbar-thumb {
                background: #E5D6B8;
                border-radius: 3px;
            }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-brand-goldLight selection:text-brand-text">
    <!-- Main Content Container -->
    <main class="flex-grow flex items-center justify-center px-4 py-2">
        <div class="w-full max-w-md">

            <!-- Welcome Header -->
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-brand-goldLight text-brand-gold mb-3 shadow-inner">
                    <i class="fa-solid fa-user-lock text-2xl"></i>
                </div>
                <h1 class="text-3xl font-bold text-brand-text tracking-tight">Welcome Back</h1>
                <p class="text-sm text-brand-subtext mt-1">Access your ComputerWala dashboard & services</p>
            </div>

            <!-- Card Container -->
            <div class="bg-white rounded-2xl shadow-xl shadow-brand-gold/5 border border-brand-goldBorder/50 overflow-hidden">

                <!-- Tab Switching Bar -->
                <div class="flex border-b border-brand-goldBorder/30 bg-brand-bg/50">
                    <button id="loginTabBtn" onclick="switchTab('login')" class="flex-1 py-4 text-center font-semibold text-brand-gold border-b-2 border-brand-gold transition-all duration-200">
                        <i class="fa-solid fa-right-to-bracket mr-2"></i>Sign In
                    </button>
                    <button id="registerTabBtn" onclick="switchTab('register')" class="flex-1 py-4 text-center font-semibold text-brand-subtext hover:text-brand-text border-b-2 border-transparent transition-all duration-200">
                        <i class="fa-solid fa-user-plus mr-2"></i>Create Account
                    </button>
                </div>

                <div class="p-6 sm:p-8">

                    <!-- Alert Message Container -->
                    <div id="alertBox" class="hidden mb-5 p-4 rounded-xl text-sm flex items-start gap-3">
                        <i id="alertIcon" class="fa-solid mt-0.5"></i>
                        <span id="alertMessage"></span>
                    </div>

                    <!-- LOGIN FORM -->
                    <form id="loginForm" asp-controller="authentication" asp-action="Login" class="space-y-5">

                        <!-- Username or Email -->
                        <div>
                            <label class="block text-xs font-semibold text-brand-text uppercase tracking-wider mb-2">Username or Email</label>
                            <div class="relative flex items-center border border-gray-200 rounded-xl px-3 py-2.5 bg-gray-50/50 transition-all input-focus">
                                <i class="fa-regular fa-envelope text-brand-gold mr-3 text-base"></i>
                                <input type="text" asp-for="@Model.Username" required placeholder="admin or name@example.com" class="w-full bg-transparent text-sm text-brand-text focus:outline-none placeholder-gray-400">
                            </div>
                        </div>

                        <!-- Password -->
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <label class="block text-xs font-semibold text-brand-text uppercase tracking-wider">Password</label>
                                <a href="javascript:void(0)" onclick="triggerForgotPassword()" class="text-xs text-brand-gold hover:underline font-medium">Forgot Password?</a>
                            </div>
                            <div class="relative flex items-center border border-gray-200 rounded-xl px-3 py-2.5 bg-gray-50/50 transition-all input-focus">
                                <i class="fa-solid fa-lock text-brand-gold mr-3 text-base"></i>
                                <input type="password" asp-for="@Model.Pwd" required placeholder="••••••••" class="w-full bg-transparent text-sm text-brand-text focus:outline-none placeholder-gray-400">
                                <button type="button" onclick="togglePasswordVisibility('loginPassword', this)" class="text-gray-400 hover:text-brand-gold focus:outline-none px-1">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Remember Me -->
                        <div class="flex items-center">
                            <input type="checkbox" id="rememberMe" class="w-4 h-4 rounded border-gray-300 text-brand-gold focus:ring-brand-gold accent-brand-gold cursor-pointer">
                            <label for="rememberMe" class="ml-2.5 text-sm text-brand-subtext cursor-pointer select-none">Remember me on this device</label>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="w-full py-3.5 bg-brand-gold hover:bg-brand-goldHover text-white font-semibold rounded-xl shadow-md shadow-brand-gold/20 transition-all transform active:scale-[0.99] flex items-center justify-center gap-2">
                            <span>Sign In</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </form>

                    <!-- REGISTER FORM -->
                    <form id="registerForm" onsubmit="handleAuthSubmit(event, 'register')" class="space-y-4 hidden">

                        <!-- Full Name -->
                        <div>
                            <label class="block text-xs font-semibold text-brand-text uppercase tracking-wider mb-1.5">Full Name</label>
                            <div class="relative flex items-center border border-gray-200 rounded-xl px-3 py-2.5 bg-gray-50/50 transition-all input-focus">
                                <i class="fa-regular fa-user text-brand-gold mr-3 text-base"></i>
                                <input type="text" id="regName" required placeholder="John Doe" class="w-full bg-transparent text-sm text-brand-text focus:outline-none placeholder-gray-400">
                            </div>
                        </div>

                        <!-- Email -->
                        <div>
                            <label class="block text-xs font-semibold text-brand-text uppercase tracking-wider mb-1.5">Email Address</label>
                            <div class="relative flex items-center border border-gray-200 rounded-xl px-3 py-2.5 bg-gray-50/50 transition-all input-focus">
                                <i class="fa-regular fa-envelope text-brand-gold mr-3 text-base"></i>
                                <input type="email" id="regEmail" required placeholder="name@domain.com" class="w-full bg-transparent text-sm text-brand-text focus:outline-none placeholder-gray-400">
                            </div>
                        </div>

                        <!-- Password -->
                        <div>
                            <label class="block text-xs font-semibold text-brand-text uppercase tracking-wider mb-1.5">Password</label>
                            <div class="relative flex items-center border border-gray-200 rounded-xl px-3 py-2.5 bg-gray-50/50 transition-all input-focus">
                                <i class="fa-solid fa-lock text-brand-gold mr-3 text-base"></i>
                                <input type="password" id="regPassword" required placeholder="Create strong password" class="w-full bg-transparent text-sm text-brand-text focus:outline-none placeholder-gray-400">
                                <button type="button" onclick="togglePasswordVisibility('regPassword', this)" class="text-gray-400 hover:text-brand-gold focus:outline-none px-1">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div>
                            <label class="block text-xs font-semibold text-brand-text uppercase tracking-wider mb-1.5">Confirm Password</label>
                            <div class="relative flex items-center border border-gray-200 rounded-xl px-3 py-2.5 bg-gray-50/50 transition-all input-focus">
                                <i class="fa-solid fa-shield-halved text-brand-gold mr-3 text-base"></i>
                                <input type="password" id="regConfirmPassword" required placeholder="Re-enter password" class="w-full bg-transparent text-sm text-brand-text focus:outline-none placeholder-gray-400">
                            </div>
                        </div>

                        <!-- Terms Checkbox -->
                        <div class="flex items-start">
                            <input type="checkbox" id="terms" required class="mt-1 w-4 h-4 rounded border-gray-300 text-brand-gold focus:ring-brand-gold accent-brand-gold cursor-pointer">
                            <label for="terms" class="ml-2.5 text-xs text-brand-subtext leading-relaxed">
                                I agree to ComputerWala's <a href="#" class="text-brand-gold underline">Terms of Service</a> and <a href="#" class="text-brand-gold underline">Privacy Policy</a>.
                            </label>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="w-full py-3.5 bg-brand-gold hover:bg-brand-goldHover text-white font-semibold rounded-xl shadow-md shadow-brand-gold/20 transition-all transform active:scale-[0.99] flex items-center justify-center gap-2 mt-2">
                            <span>Register Account</span>
                            <i class="fa-solid fa-check text-xs"></i>
                        </button>
                    </form>

                    <!-- Social Divider -->
                    <div class="relative my-6 text-center">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-200"></div>
                        </div>
                        <span class="relative bg-white px-4 text-xs uppercase tracking-wider text-brand-subtext font-medium">Or continue with</span>
                    </div>

                    <!-- Social Buttons -->
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" onclick="socialAuth('Google')" class="flex items-center justify-center gap-2 py-2.5 px-4 border border-gray-200 rounded-xl hover:bg-brand-bg transition-colors text-sm font-medium text-brand-text">
                            <i class="fa-brands fa-google text-red-500"></i>
                            <span>Google</span>
                        </button>
                        <button type="button" onclick="socialAuth('GitHub')" class="flex items-center justify-center gap-2 py-2.5 px-4 border border-gray-200 rounded-xl hover:bg-brand-bg transition-colors text-sm font-medium text-brand-text">
                            <i class="fa-brands fa-github text-gray-800"></i>
                            <span>GitHub</span>
                        </button>
                    </div>

                </div>
            </div>

            <!-- Back to Home Link -->
            <div class="text-center mt-6">
                <a href="#" class="inline-flex items-center gap-2 text-sm text-brand-subtext hover:text-brand-gold transition-colors font-medium">
                    <i class="fa-solid fa-arrow-left text-xs"></i>
                    <span>Return to ComputerWala Home</span>
                </a>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer class="w-full py-6 border-t border-brand-goldBorder/40 text-center text-xs text-brand-subtext">
        <p>&copy; 2026 ComputerWala. All rights reserved.</p>
    </footer>

    <!-- Interactive Logic Script -->
    <script>
            // Tab switching function
            function switchTab(mode) {
                const loginForm = document.getElementById('loginForm');
                const registerForm = document.getElementById('registerForm');
                const loginBtn = document.getElementById('loginTabBtn');
                const registerBtn = document.getElementById('registerTabBtn');
                const alertBox = document.getElementById('alertBox');

                alertBox.classList.add('hidden');

                if (mode === 'login') {
                    loginForm.classList.remove('hidden');
                    registerForm.classList.add('hidden');

                    loginBtn.className = "flex-1 py-4 text-center font-semibold text-brand-gold border-b-2 border-brand-gold transition-all duration-200";
                    registerBtn.className = "flex-1 py-4 text-center font-semibold text-brand-subtext hover:text-brand-text border-b-2 border-transparent transition-all duration-200";
                } else {
                    loginForm.classList.add('hidden');
                    registerForm.classList.remove('hidden');

                    registerBtn.className = "flex-1 py-4 text-center font-semibold text-brand-gold border-b-2 border-brand-gold transition-all duration-200";
                    loginBtn.className = "flex-1 py-4 text-center font-semibold text-brand-subtext hover:text-brand-text border-b-2 border-transparent transition-all duration-200";
                }
            }

            // Toggle password visibility
            function togglePasswordVisibility(inputId, btn) {
                const input = document.getElementById(inputId);
                const icon = btn.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.className = 'fa-regular fa-eye-slash';
                } else {
                    input.type = 'password';
                    icon.className = 'fa-regular fa-eye';
                }
            }

            // Display feedback messages
            function showAlert(message, type = 'error') {
                const alertBox = document.getElementById('alertBox');
                const alertIcon = document.getElementById('alertIcon');
                const alertMessage = document.getElementById('alertMessage');

                alertBox.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'bg-green-50', 'text-green-700', 'border-red-200', 'border-green-200');

                if (type === 'error') {
                    alertBox.classList.add('bg-red-50', 'text-red-700', 'border', 'border-red-200');
                    alertIcon.className = 'fa-solid fa-circle-exclamation text-red-500';
                } else {
                    alertBox.classList.add('bg-green-50', 'text-green-700', 'border', 'border-green-200');
                    alertIcon.className = 'fa-solid fa-circle-check text-green-500';
                }

                alertMessage.textContent = message;
            }

            // Handle submission
            function handleAuthSubmit(event, mode) {
                event.preventDefault();

                if (mode === 'register') {
                    const pass = document.getElementById('regPassword').value;
                    const confirmPass = document.getElementById('regConfirmPassword').value;

                    if (pass !== confirmPass) {
                        showAlert('Passwords do not match. Please re-enter.', 'error');
                        return;
                    }

                    showAlert('Account created successfully! Redirecting...', 'success');
                } else {
                    showAlert('Login successful! Redirecting to dashboard...', 'success');
                }
            }

            function triggerForgotPassword() {
                showAlert('Password reset link has been sent to your registered email.', 'success');
            }

            function socialAuth(provider) {
                showAlert(`Connecting with ${provider}...`, 'success');
            }
    </script>
</body>
</html>